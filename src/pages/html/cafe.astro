---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Estes Cafe">
  <section class="page-hero cafe-hero">
    <div class="hero-content">
      <p class="eyebrow">Estes Cafe</p>
      <h1>Estes Cafe</h1>
      <p class="hero-subtitle">
        Coffee, food, ideas, and whatever this eventually turns into.
      </p>
    </div>
  </section>

  <main class="simple-page">
    <section class="card work-in-progress-card">
      <p class="eyebrow">Work In Progress</p>

      <h2>This page is currently under construction.</h2>

      <p>
        The Estes Cafe is our recipes that we love and are exploring as we grow our family.
      </p>

      <p>
        For now, this section of the site is still being worked on.
      </p>
    </section>
  </main>
</BaseLayout>