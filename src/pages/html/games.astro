---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Games">
  <section class="page-hero games-hero">
    <div class="hero-content">
      <p class="eyebrow">Games</p>
      <h1>Games</h1>
      <p class="hero-subtitle">
        A collection of games, experiments, and interactive projects.
      </p>
    </div>
  </section>

  <main class="simple-page">
    <section class="card work-in-progress-card">
      <p class="eyebrow">Work In Progress</p>

      <h2>This page is currently under construction.</h2>

      <p>
        I plan to eventually add something here to make games I play with family members a better experience.
      </p>

      <p>
        For now, this page is still being designed and built out.
      </p>
    </section>
  </main>
</BaseLayout>