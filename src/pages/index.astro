---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Home">
  <!-- Page Header -->
  <section class="page-hero home-hero">
    <div class="hero-content">
      <p class="eyebrow">Tech Enthusiast, Sports Fanatic</p>
      <h1>Jack Estes</h1>
      <p class="hero-subtitle">
        BSIS, CS Minor, Software Dev, & More
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="content-section">
    <div class="card-grid home-card-grid">
      <article class="card link-card">
        <a href="/html/resume.html">
          <p class="eyebrow">Resume</p>
          <h2>Resume</h2>
          <p>BSIS, CS Minor, Software Dev, & More</p>
          <span class="accent-link">View Resume →</span>
        </a>
      </article>

      <article class="card link-card">
        <a href="/html/side-projects.html">
          <p class="eyebrow">Projects</p>
          <h2>Side Projects</h2>
          <p>
            Tech Side Projects & Links - Jailbreaking, Home Serving, Custom Blocking, & Others
          </p>
          <span class="accent-link">View Side Projects →</span>
        </a>
      </article>

      <article class="card link-card">
        <a href="/html/about-me.html">
          <p class="eyebrow">About</p>
          <h2>About Me</h2>
          <p>My Life, My Hobbies, My Skills, & More!</p>
          <span class="accent-link">Learn More →</span>
        </a>
      </article>
    </div>
  </section>
</BaseLayout>